{
  "name": "sideband-comments-chrome",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "prepackage": "node ../../scripts/check-app-version-line.mjs",
    "package": "npm run build && node package.mjs",
    "prepackage:webstore": "node ../../scripts/check-app-version-line.mjs",
    "package:webstore": "npm run build && node package.mjs --webstore",
    "test:browser": "node test/browser.mjs",
    "test:ui": "node test/ui.mjs"
  },
  "dependencies": {
    "@sideband-comments/browser-protocol": "0.1.0",
    "@sideband-comments/core": "0.1.0",
    "github-markdown-css": "5.9.0",
    "markdown-it": "14.3.3",
    "mermaid": "11.12.0",
    "prismjs": "1.30.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/prismjs": "^1.26.5",
    "jsdom": "26.1.0",
    "playwright-core": "^1.56.0"
  }
}
