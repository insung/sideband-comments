{
  "name": "sideband-comments-vscode",
  "displayName": "Sideband Comments",
  "description": "Shared sidecar comment threads for VS Code and Obsidian.",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "publisher": "insung",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/insung/sideband-comments.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": ["Other", "Visualization"],
  "main": "./dist/extension.cjs",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "sidebandComments.add", "title": "Sideband Comments: Add Comment on Selection" },
      { "command": "sidebandComments.create", "title": "Comment", "enablement": "!commentIsEmpty" },
      { "command": "sidebandComments.reply", "title": "Reply", "enablement": "!commentIsEmpty" },
      { "command": "sidebandComments.resolve", "title": "Sideband Comments: Resolve" },
      { "command": "sidebandComments.reopen", "title": "Sideband Comments: Reopen" },
      { "command": "sidebandComments.reanchor", "title": "Sideband Comments: Re-anchor to Selection" },
      { "command": "sidebandComments.deleteComment", "title": "Sideband Comments: Delete Comment", "icon": "$(trash)" },
      { "command": "sidebandComments.showResolved", "title": "Sideband Comments: Show Resolved", "icon": "$(eye)" },
      { "command": "sidebandComments.hideResolved", "title": "Sideband Comments: Hide Resolved", "icon": "$(eye-closed)" },
      { "command": "sidebandComments.reload", "title": "Sideband Comments: Reload", "icon": "$(refresh)" }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        { "id": "sideband-comments-overview", "title": "Sideband Comments", "icon": "$(comment-discussion)" }
      ]
    },
    "views": {
      "sideband-comments-overview": [
        {
          "id": "sidebandComments.overviewView",
          "name": "Comments Explorer",
          "contextualTitle": "Sideband Comments",
          "icon": "$(comment-discussion)"
        },
        {
          "id": "sidebandComments.detailView",
          "name": "Comment Details",
          "contextualTitle": "Sideband Comments",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "configuration": {
      "title": "Sideband Comments",
      "properties": {
        "sidebandComments.authorName": {
          "type": "string",
          "default": "",
          "description": "Comment author. Empty uses the operating-system user name."
        },
        "sidebandComments.showResolved": {
          "type": "boolean",
          "default": true,
          "description": "Keep resolved threads visible in the editor and Sideband Comments view."
        }
      }
    },
    "menus": {
      "editor/context": [
        { "command": "sidebandComments.add", "when": "editorHasSelection", "group": "z_commands@100" }
      ],
      "view/title": [
        { "command": "sidebandComments.showResolved", "when": "(view == sidebandComments.overviewView || view == sidebandComments.detailView || view == workbench.panel.comments) && !sidebandComments.showResolved", "group": "navigation@1" },
        { "command": "sidebandComments.hideResolved", "when": "(view == sidebandComments.overviewView || view == sidebandComments.detailView || view == workbench.panel.comments) && sidebandComments.showResolved", "group": "navigation@1" },
        { "command": "sidebandComments.reload", "when": "view == sidebandComments.overviewView || view == sidebandComments.detailView || view == workbench.panel.comments", "group": "navigation@2" }
      ],
      "comments/commentThread/title": [
        { "command": "sidebandComments.resolve", "when": "commentThread == sideband.open", "group": "inline@1" },
        { "command": "sidebandComments.reopen", "when": "commentThread == sideband.resolved", "group": "inline@1" },
        { "command": "sidebandComments.reanchor", "group": "inline@2" }
      ],
      "comments/comment/title": [
        { "command": "sidebandComments.deleteComment", "when": "comment == sideband.comment", "group": "inline@3" }
      ],
      "comments/commentThread/context": [
        { "command": "sidebandComments.create", "when": "commentController == sidebandComments && commentThreadIsEmpty", "group": "inline" },
        { "command": "sidebandComments.reply", "when": "commentController == sidebandComments && !commentThreadIsEmpty", "group": "inline" }
      ]
    }
  },
  "scripts": {
    "test:integration": "npm run build && node test/integration/run.mjs",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "prepackage": "node ../../scripts/check-app-version-line.mjs",
    "package": "npm run build && vsce package --no-dependencies --out dist/sideband-comments-vscode-0.2.0.vsix"
  },
  "dependencies": {
    "@sideband-comments/core": "0.1.0",
    "@sideband-comments/jsonl-store": "0.1.0"
  }
}
